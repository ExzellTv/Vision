DATABASE_URL=postgresql://vision:vision@localhost:5432/vision
REDIS_URL=redis://localhost:6379/0

# MongoDB (Atlas) — map data: comparables and land listings
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
MONGODB_DB=vision

# Autodesk Platform Services
APS_CLIENT_ID=your_aps_client_id
APS_CLIENT_SECRET=your_aps_client_secret

# Materials Pricing API
MATERIALS_API_KEY=your_materials_api_key

# CesiumJS Ion
CESIUM_ION_TOKEN=your_cesium_token
